{
  "name": "govee-control-hub",
  "version": "2.1.0",
  "description": "React + latest shadcn/ui local control hub for Govee LAN devices, Direct/Razer/DreamView packets and Govee H5122 BLE button events.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "imports": {
    "#components/*": "./src/components/*.jsx",
    "#ui/*": "./src/components/ui/*.jsx",
    "#lib/*": "./src/lib/*.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server.js\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "check": "node --check server.js && vite build",
    "shadcn:init": "shadcn init --base radix",
    "shadcn:info": "shadcn info",
    "shadcn:add": "shadcn add"
  },
  "keywords": [
    "govee",
    "lan-api",
    "udp",
    "bluetooth",
    "ble",
    "h5122",
    "react",
    "shadcn-ui",
    "radix-ui",
    "smart-home"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "shadcn": "^4.10.0"
  },
  "optionalDependencies": {
    "@stoprocent/noble": "^2.3.2"
  }
}
